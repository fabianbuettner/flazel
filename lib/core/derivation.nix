# Generic Flazel derivation builder (language-agnostic)
#
# Provides a minimal Bazel build derivation without any language-specific
# assumptions. Language-specific modules (cc, rust, etc.) can wrap this
# and add their own configuration.
#
# Usage:
#   build = flazel.lib.mkFlazelDerivation {
#     inherit pkgs;
#     name = "my-project";
#     src = ./.;
#     caches = flazel.lib.mkBcrCaches { ... };
#     bazelCommand = "build //...";
#     installPhase = "cp -rL bazel-bin/* $out/";
#   };
#
let
  inherit (import ./constants.nix) nixDepsDir;
in
rec {
  # Generate .bazelrc.nix lines for flazel module override and non-BCR deps
  mkBazelrcFooter =
    {
      flazelPath ? null,
      caches,
    }:
    # `common`, not `build`: `bazel mod` subcommands (used by flazel-lock-archives)
    # resolve modules too but read no build-scoped flags; Bazel 7 ignores
    # common-scoped flags a command does not support.
    (if flazelPath != null then "common --override_module=flazel=${flazelPath}\n" else "")
    + (
      if caches ? nonBcrOverrideFlags && caches.nonBcrOverrideFlags != "" then
        caches.nonBcrOverrideFlags + "\n"
      else
        ""
    );

  # Generate complete .bazelrc.nix content from toolchain registration lines + footer
  mkBazelrcContent =
    {
      toolchainLines,
      flazelPath ? null,
      caches,
    }:
    "# Auto-generated by flazel - DO NOT EDIT\n"
    # Pure bzlmod: disable the legacy WORKSPACE suffix (still on by default in
    # Bazel 7). It pulls deps like bazel_skylib from github via maybe(http_archive),
    # which the BCR cache cannot cover and which fail in the offline sandbox.
    # Set here (not in the build path) so the dev shell and the build resolve
    # dependencies under identical rules.
    + "common --noenable_workspace\n"
    + toolchainLines
    + (mkBazelrcFooter { inherit flazelPath caches; });

  # Generate shell script to set up .nix-bazel-deps directory (core setup).
  # Writes the framework .bazelrc.nix (flazel override + non-BCR overrides plus
  # whatever toolchain registration lines the language module supplies). Language
  # modules add only their symlinks and marker via extraSetup; a bare-core build
  # still gets the flazel override because toolchainLines defaults to empty.
  mkFlazelDepsSetup =
    {
      pkgs,
      caches,
      # Path to flazel source (auto-injected, used for --override_module in .bazelrc.nix)
      flazelPath ? null,
      # Language-specific toolchain registration lines (e.g. --extra_toolchains)
      toolchainLines ? "",
      # Optional: additional setup for toolchain/libs (provided by language modules)
      extraSetup ? "",
    }:
    let
      bazelrc = pkgs.writeText "flazel-bazelrc.nix" (mkBazelrcContent {
        inherit toolchainLines flazelPath caches;
      });
    in
    ''
      # ${nixDepsDir} is SHARED STATE that bazel reads, and this setup runs on every
      # `nix develop` entry -- including `nix develop --command bazel ...`, the form a
      # consumer is told to use per command, so it routinely runs while another bazel
      # invocation is starting.
      #
      # It used to `rm -rf` the directory and rebuild it. For the length of two
      # recursive cache copies, every file a consumer's .bazelrc try-imports was
      # ABSENT, and so was ${nixDepsDir}/libs. try-import accepts an absent file in
      # silence exactly as it accepts an empty one, so a bazel start landing in that
      # window lost its toolchain flags with no error and failed later somewhere
      # unrelated -- as missing headers for libraries the toolchain names, which is
      # how this was found.
      #
      # So nothing is deleted wholesale, and every piece is replaced only when its
      # content changes. These are all copies of immutable store paths, so "changes"
      # is false except after a flake update: the usual entry now touches nothing,
      # which also stops a large recursive copy from running every time.
      #
      # Only genuinely mutable state is a real file here: the two caches, which bazel
      # writes into. Everything else in ${nixDepsDir} is a pure function of the
      # configuration, so it is built once into the store and reached by one symlink,
      # rather than assembled in place on every entry. A language module that merges
      # several toolchains into one tree does that merge in a derivation, not in this
      # hook: the result is identical, it is cached, and the entry then costs one
      # readlink instead of a subprocess per entry per file.
      #
      # These two helpers are part of the dev shell's contract. They are defined before
      # extraSetup is interpolated, so a language module may call them, and they are
      # still in scope in the consumer's own shellHook, which the core dev shell
      # appends after this.

      # Replace $2 with the file $1, only if it differs, by rename (atomic within a
      # filesystem) so a reader sees the old file whole or the new one whole. Needed
      # only where a file cannot be a store path: the build appends cache flags to
      # .bazelrc.nix that are sandbox-absolute, so that one is written, not linked.
      flazel_put() {
          if cmp -s "$1" "$2"; then
              return 0
          fi
          _fz_tmp="$2.tmp.$$"
          cp "$1" "$_fz_tmp"
          chmod u+w "$_fz_tmp"
          mv -f "$_fz_tmp" "$2"
      }

      # Point symlink $2 at $1. `ln -s` without -f fails when the link exists, which
      # is why the `rm -rf` above was load-bearing; `ln -sfn` would unlink first and
      # leave the path briefly absent, which is the same hazard in miniature. Skip
      # when it already points there, otherwise rename a temporary link over it.
      flazel_link() {
          if [ "$(readlink "$2" 2>/dev/null)" = "$1" ]; then
              return 0
          fi
          # A real directory at the destination is the layout this replaced, which
          # assembled these trees in place. `mv -T` refuses to overwrite one, so it has
          # to go. That reopens the absence window for exactly the single entry that
          # upgrades a stale layout, which is the only way to leave that layout behind
          # at all; every entry after it takes the branch above and writes nothing.
          if [ -d "$2" ] && [ ! -L "$2" ]; then
              rm -rf "$2"
          fi
          _fz_tmp="$2.tmp.$$"
          ln -sfn "$1" "$_fz_tmp"
          mv -Tf "$_fz_tmp" "$2"
      }

      mkdir -p ${nixDepsDir}

      # The caches are directories, so they cannot be swapped by a single rename.
      # Gating them on which store paths they came from means the copy happens once
      # per flake change rather than once per entry, and the brief window when it
      # does run fails LOUDLY (bazel reports a missing repository cache) rather than
      # silently dropping flags.
      # Layout of older flazel versions: an in-workspace repository cache and
      # file:// registry copy.
      rm -rf ${nixDepsDir}/repo-cache ${nixDepsDir}/registry ${nixDepsDir}/.cache-stamp

      # Bazel writes into its repository cache and, from Bazel 9, refuses one
      # inside the workspace. It is content-addressed, so one per user serves
      # every project; each prefetched cache is merged into it once.
      _fz_repo_cache="''${XDG_CACHE_HOME:-$HOME/.cache}/flazel/repo-cache"
      _fz_seeded="$_fz_repo_cache/.seeded/$(basename ${caches.bazelRepoCache})"
      if [ ! -e "$_fz_seeded" ]; then
          mkdir -p "$_fz_repo_cache/.seeded"
          cp -rnL ${caches.bazelRepoCache}/. "$_fz_repo_cache"
          chmod -R u+w "$_fz_repo_cache"
          touch "$_fz_seeded"
      fi

      # Framework bazelrc (override + non-BCR + toolchains) plus the repository
      # cache, whose path is only known here.
      _fz_rc="${nixDepsDir}/.bazelrc.nix.new.$$"
      cat ${bazelrc} > "$_fz_rc"
      echo "common --repository_cache=$_fz_repo_cache" >> "$_fz_rc"
      flazel_put "$_fz_rc" ${nixDepsDir}/.bazelrc.nix
      rm -f "$_fz_rc"
      ${extraSetup}
    '';

  # Generic Bazel build derivation
  mkFlazelDerivation =
    {
      pkgs,
      name,
      src,
      caches,
      bazelCommand,
      installPhase,
      # Bazel package to use (defaults to latest stable)
      bazel ? pkgs.bazel,
      # Path to flazel source (auto-injected, used for --override_module in .bazelrc.nix)
      flazelPath ? null,
      # Optional: extra setup script (for language-specific toolchain/libs)
      extraDepsSetup ? "",
      # Language-specific toolchain registration lines for .bazelrc.nix
      toolchainLines ? "",
      nativeBuildInputs ? [ ],
      buildInputs ? [ ],
      runtimeDependencies ? [ ],
      bazelOutputBase ? "$TMPDIR/bazel-out",
    }:
    pkgs.stdenv.mkDerivation {
      inherit
        name
        src
        installPhase
        runtimeDependencies
        ;

      nativeBuildInputs = [
        bazel
        pkgs.coreutils
      ]
      ++ nativeBuildInputs;

      inherit buildInputs;

      buildPhase = ''
        export HOME=$TMPDIR
        ${mkFlazelDepsSetup {
          inherit
            pkgs
            caches
            flazelPath
            toolchainLines
            ;
          extraSetup = extraDepsSetup;
        }}
        bazel --output_user_root=${bazelOutputBase} ${bazelCommand}
      '';
    };
}
