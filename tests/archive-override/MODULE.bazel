module(
    name = "flazel-archive-override-test",
)

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "flazel")
bazel_dep(name = "platforms", version = "1.0.0")

local_path_override(
    module_name = "flazel",
    path = "../..",
)

# A module already in the graph, taken from an archive instead of the registry:
# the lockfile records no source for it, so only the manifest makes it offline.
archive_override(
    module_name = "platforms",
    integrity = "sha256-M4TrHDB2JwT7445EAgThFBVAhsj8iowuPihEECjAGag=",
    urls = ["https://github.com/bazelbuild/platforms/releases/download/1.0.0/platforms-1.0.0.tar.gz"],
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Cached offline under the urls joined, and fetched by Nix from the second.
http_file(
    name = "two_urls",
    sha256 = "11b71e04dd3a38a80a06ec92b77a99bcded6e91c008b3f613528262329b45e73",
    urls = [
        "https://example.invalid/module_dot_bazel.patch",
        "https://bcr.bazel.build/modules/zlib/1.3.1.bcr.3/patches/module_dot_bazel.patch",
    ],
)

# Cached offline under its canonical id instead.
http_file(
    name = "with_canonical_id",
    canonical_id = "flazel-archive-override-test",
    sha256 = "1387113ca60c92603025ac95a9d1f3b1218ae44c253248e98849accc64f78f82",
    urls = ["https://bcr.bazel.build/modules/zlib/1.3.1.bcr.3/patches/add_build_file.patch"],
)

nix_cc = use_extension("@flazel//bazel:nix_cc.bzl", "nix_cc")
nix_cc.toolchain(name = "default")
use_repo(
    nix_cc,
    "local_config_cc_default",
    "local_config_cc_default_deps",
)
