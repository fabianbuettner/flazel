module(
    name = "flazel-cc-test",
)

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "flazel")
bazel_dep(name = "platforms", version = "1.0.0")

local_path_override(
    module_name = "flazel",
    path = "../..",
)

# Code compiled in an external repository (threads/).
bazel_dep(name = "flazel-cc-test-dep")
local_path_override(
    module_name = "flazel-cc-test-dep",
    path = "dep",
)

# CC toolchains. Most checks symlink a different cfg (gcc, clang, ...) as
# "default" and leave the others absent. The selection checks provide all three
# at once, for the same x86_64-linux target, and pick one with --platforms.
nix_cc = use_extension("@flazel//bazel:nix_cc.bzl", "nix_cc")
nix_cc.toolchain(name = "default")
nix_cc.toolchain(name = "clang")
nix_cc.toolchain(name = "musl")
nix_cc.package(name = "headers_probe")
nix_cc.package(name = "zlib")
use_repo(
    nix_cc,
    "headers_probe",
    "local_config_cc_clang",
    "local_config_cc_default",
    "local_config_cc_default_deps",
    "local_config_cc_musl",
    "zlib",
)
