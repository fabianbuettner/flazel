"""rules_perl target and exec toolchains over the Nix perl that a dev shell or
build given `perl` links at .nix-bazel-deps/PERL_DIR. The consumer names the
repo PERL_REPO. See README, Perl.
"""

load(":nix_common.bzl", "NIX_DEPS_DIR", "dir_exists", "host_constraints", "resolve_path")

# The perl's link in NIX_DEPS_DIR; Nix reads both names via constants.nix.
PERL_DIR = "perl"

# The name the consumer gives the repo.
PERL_REPO = "nix_perl"

def _nix_perl_impl(repository_ctx):
    perl = resolve_path(repository_ctx, NIX_DEPS_DIR + "/" + PERL_DIR)
    if not dir_exists(repository_ctx, perl + "/bin"):
        fail("No Nix perl at {}. Pass `perl = pkgs.perl` to flazel's dev shell or mkDerivation.".format(perl))

    # perl_toolchain finds both by their bin/ suffix.
    for tool in ["perl", "xsubpp"]:
        repository_ctx.symlink(perl + "/bin/" + tool, "bin/" + tool)
    cpu, os = host_constraints(repository_ctx)
    repository_ctx.file("BUILD.bazel", """\
# Generated by flazel's nix_perl rule. Do not edit.
load("@rules_perl//perl:toolchain.bzl", "perl_toolchain")

# No XS: perl_xs would need the interpreter's %Config flags and a matching C
# toolchain, neither of which this toolchain describes.
perl_toolchain(
    name = "toolchain_impl",
    runtime = ["bin/perl", "bin/xsubpp"],
    supports_xs = False,
)

toolchain(
    name = "toolchain",
    target_compatible_with = ["{cpu}", "{os}"],
    toolchain = ":toolchain_impl",
    toolchain_type = "@rules_perl//perl:toolchain_type",
)

toolchain(
    name = "exec_toolchain",
    exec_compatible_with = ["{cpu}", "{os}"],
    toolchain = ":toolchain_impl",
    toolchain_type = "@rules_perl//perl:exec_toolchain_type",
)
""".format(cpu = cpu, os = os))

nix_perl = repository_rule(
    implementation = _nix_perl_impl,
    local = True,
    doc = "rules_perl target and exec toolchains over the Nix perl in .nix-bazel-deps.",
)
